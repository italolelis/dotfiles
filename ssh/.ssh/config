# SSH Configuration
#
# Keys live in ~/.ssh/ and are NEVER tracked in this repo (see
# ssh/.stow-local-ignore). Generate them per-machine:
#   ssh-keygen -t ed25519 -C "you@example.com"

# Global settings
Host *
    # UseKeychain is macOS-only; IgnoreUnknown stops Linux OpenSSH
    # from erroring out on it.
    IgnoreUnknown UseKeychain
    # Security settings
    Protocol 2
    HashKnownHosts yes
    GSSAPIAuthentication no
    GSSAPIDelegateCredentials no

    # Performance settings
    Compression yes
    TCPKeepAlive yes
    ServerAliveInterval 60
    ServerAliveCountMax 3

    # Key settings
    # AddKeysToAgent loads the key into ssh-agent on first use;
    # UseKeychain persists its passphrase in the macOS Keychain so it
    # survives reboots without prompting. Together these replace the
    # 1Password SSH agent.
    AddKeysToAgent yes
    UseKeychain yes
    IdentitiesOnly yes

    # Connection settings
    ControlMaster auto
    ControlPath ~/.ssh/control-%h-%p-%r
    ControlPersist 10m

    # Logging
    LogLevel INFO

# GitHub
Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes

# Example server configuration
# Host myserver
#     HostName 192.168.1.100
#     User myuser
#     Port 22
#     IdentityFile ~/.ssh/id_ed25519
#     ForwardAgent yes
#     RemoteForward 8080 localhost:8080

# Example jump host configuration
# Host internal-server
#     HostName 10.0.0.100
#     User internal-user
#     ProxyJump jump-host
#     IdentityFile ~/.ssh/internal_key

# Example jump host
# Host jump-host
#     HostName 203.0.113.1
#     User jump-user
#     IdentityFile ~/.ssh/jump_key
