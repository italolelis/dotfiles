# SSH Configuration
#
# Keys live in ~/.ssh/ and are NEVER tracked in this repo (see
# ssh/.stow-local-ignore). Generate them per-machine:
#   ssh-keygen -t ed25519 -C "you@example.com"
#
# This repo is PUBLIC. Real hosts — addresses, usernames, ports, jump hosts —
# belong in ~/.ssh/config.local, which is untracked and never stowed. Include
# comes first on purpose: ssh takes the FIRST value obtained for each keyword,
# so the local file always wins over anything below.
#
# A missing ~/.ssh/config.local is not an error, so this stays valid on a fresh
# machine. The homelab entries are generated by `make ssh-config` in the
# (private) homelab repo.
Include ~/.ssh/config.local

# Global settings
Host *
    # Security settings
    Protocol 2
    HashKnownHosts yes
    GSSAPIAuthentication no
    GSSAPIDelegateCredentials no

    # Performance settings
    Compression yes
    TCPKeepAlive yes
    ServerAliveInterval 60
    ServerAliveCountMax 3

    # Key settings
    # Keys live in Proton Pass (vault "SSH Keys"), served by pass-cli's SSH
    # agent: a LaunchAgent on macOS, a systemd user unit on Linux. A missing
    # socket is not an error; ssh falls back to key files on disk.
    # AddKeysToAgent/UseKeychain removed 2026-10-15: they fed the macOS agent,
    # which no longer holds the keys.
    IdentityAgent ~/.ssh/proton-pass-agent.sock
    # Only keys named by an IdentityFile, or the default ~/.ssh/id_* (the .pub
    # is enough when the private key lives in the agent), are offered.
    IdentitiesOnly yes

    # Connection settings
    ControlMaster auto
    ControlPath ~/.ssh/control-%h-%p-%r
    ControlPersist 10m

    # Logging
    LogLevel INFO

# GitHub
Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes

# Example server configuration
# Host myserver
#     HostName 192.168.1.100
#     User myuser
#     Port 22
#     IdentityFile ~/.ssh/id_ed25519
#     ForwardAgent yes
#     RemoteForward 8080 localhost:8080

# Example jump host configuration
# Host internal-server
#     HostName 10.0.0.100
#     User internal-user
#     ProxyJump jump-host
#     IdentityFile ~/.ssh/internal_key

# Example jump host
# Host jump-host
#     HostName 203.0.113.1
#     User jump-user
#     IdentityFile ~/.ssh/jump_key
