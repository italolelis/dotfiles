[user]
	email = 1108049+italolelis@users.noreply.github.com
	name = italolelis
	# SSH signing (2026-10-15): the key lives in Proton Pass and its SSH agent signs.
	# Was GPG key 5CB8AEE431026C4C; gpg.program stays so older commits still verify.
	signingkey = key::ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJFQBDvnn/NO1NYHE4EWd8Gqw7xR7lqSRTxkHyHVwytr

[github]
	user = italolelis

[core]
	excludesfile = ~/.gitignore_global
	# editor removed 2026-10-23: comes from GIT_EDITOR/EDITOR in zsh/.exports,
	# which picks cursor where installed and nvim elsewhere (Linux).
	filemode = false
	trustctime = false
	autocrlf = input
	untrackedCache = true
	pager = diff-so-fancy | less --tabs=4 -RFX
	ignorecase = false

[pull]
	rebase = true

# credential.helper moved 2026-10-23 to the untracked ~/.gitconfig.local
# (written by install.sh): osxkeychain on macOS, libsecret on Linux.

[gpg]
	format = ssh
	program = gpg
[gpg "ssh"]
	# Lets `git log --show-signature` verify our own SSH signatures.
	allowedSignersFile = ~/.config/git/allowed_signers

[commit]
	gpgsign = true

[tag]
	gpgsign = true

[init]
	defaultBranch = main

[push]
	default = simple
	followTags = true

[fetch]
	prune = true

[grep]
	lineNumber = true

[help]
	autocorrect = 1

[alias]
	amend = commit --amend --reuse-message=HEAD
	br = branch
	ci = commit
	co = checkout
	contrib = shortlog --summary --numbered
	cr = clone --recursive
	df = diff --word-diff
	g = grep --break --heading --line-number
	l = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
	ld = "!sh -c \"git log --since '${1:-1} days ago' --oneline --author $(git config user.email)\" -"
	lg = log -p
	ll = log --pretty=oneline --graph --abbrev-commit
	lm = log --pretty=format:'* %s (%h)'
	patch = !git --no-pager diff --no-color
	p = push
	pf = push --force
	pr = "!f() { git fetch -fu ${2:-origin} refs/pull/$1/head:pr/$1 && git checkout pr/$1; }; f"
	show-ignored = "! git clean -ndX | perl -pe 's/Would remove/Ignored:/'"
	st = status
	stl = ls-files -m -o --exclude-standard
	sts = status -sb
	unstage = reset --hard HEAD
	# Modern git aliases
	graph = log --graph --oneline --all
	last = log -1 HEAD
	visual = !gitk
	who = shortlog -s --
	# GitHub specific
	prc = "!f() { git fetch origin pull/$1/head:pr-$1 && git checkout pr-$1; }; f"
	prm = "!f() { git fetch origin pull/$1/head:pr-$1 && git merge pr-$1; }; f"
	# Workflow helpers
	undo = reset --soft HEAD~1
	cleanup = "!git branch --merged | grep -v '\\*\\|main\\|develop' | xargs -n 1 git branch -d"
	# Status helpers
	changes = diff --name-only
	staged = diff --cached --name-only
	unmerged = diff --name-only --diff-filter=U

# Machine-specific overrides (untracked, written by install.sh). Last, so it wins.
[include]
	path = ~/.gitconfig.local
