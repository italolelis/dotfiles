#!/usr/bin/env bash
# ~/.dotfiles/bin/.local/bin/dot — update dotfiles, packages, and plugins
# Usage: dot
set -euo pipefail

DOTFILES="$HOME/.dotfiles"
# Keep in sync with PACKAGES in ~/.dotfiles/install.sh
PACKAGES=(bash git tmux starship cship cmux k9s pi mise ssh misc bin)
LINUX_PACKAGES=(ghostty hypr wave-xlr)  # Keep in sync with LINUX_PACKAGES in install.sh

PLATFORM="$(/usr/bin/uname -s)"
IS_MACOS=false
IS_LINUX=false
case "$PLATFORM" in
  Darwin) IS_MACOS=true ;;
  Linux)  IS_LINUX=true ;;
esac

log()  { echo "  $1"; }
info() { echo ""; echo "==> $1"; }
ok()   { echo "  [ok] $1"; }

# 1. Pull latest changes
info "Pulling dotfiles..."
git -C "$DOTFILES" pull --ff-only
ok "git pull"

# 2. Restow all packages (prunes stale symlinks, creates new ones)
info "Restowing packages..."
pkgs=("${PACKAGES[@]}")
if $IS_LINUX; then pkgs+=("${LINUX_PACKAGES[@]}"); fi
for pkg in "${pkgs[@]}"; do
  if [[ -d "$DOTFILES/$pkg" ]]; then
    stow --restow --no-folding --target="$HOME" --dir="$DOTFILES" "$pkg"
    ok "$pkg"
  fi
done

# 3. Update Homebrew (macOS only)
if $IS_MACOS; then
  info "Updating Homebrew..."
  brew update && brew upgrade && brew cleanup
  ok "brew"
fi

# 4. Install anything new in the Archfile (Arch only). System upgrades stay
#    with `omarchy-update`.
if $IS_LINUX && command -v pacman &>/dev/null; then
  "$DOTFILES/bin/.local/bin/arch-bundle" install
fi

# 5. Install anything new in the mise config
if command -v mise &>/dev/null; then
  info "Installing mise tools..."
  mise install
  ok "mise"
fi

echo ""
echo "=============================="
echo "  dot: done"
echo "=============================="
