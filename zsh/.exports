# Environment variable exports
# NOTE: All PATH modifications live in .path — do NOT add PATH exports here.

# Locale
export LANG='en_US.UTF-8'
export LC_ALL='en_US.UTF-8'

# Default applications
export EDITOR="cursor"
export VISUAL="cursor"
export PAGER="less"

# SSH agent: Proton Pass (pass-cli ssh-agent; ssh itself finds it through
# IdentityAgent in ~/.ssh/config). Exported for tools that read SSH_AUTH_SOCK
# directly, like ssh-add and git's SSH signing, and only while the socket exists,
# so the system agent stays the fallback.
[[ -S "$HOME/.ssh/proton-pass-agent.sock" ]] && export SSH_AUTH_SOCK="$HOME/.ssh/proton-pass-agent.sock"

# Starship prompt config location (wires starship/.starship.toml Stow package)
export STARSHIP_CONFIG="$HOME/.starship.toml"

# Node.js and npm
# NODE_ENV is deliberately NOT set globally. Build tools set it themselves
# (`next build` → production, `next dev` → development). A stray global value
# makes bundlers resolve dev-only package exports during a production build:
# Next 16 rejects it outright, and React fails with a confusing
# "Cannot read properties of null (reading 'useContext')". Set it per-command
# if a script genuinely needs it. Removed 2026-07-25.
export npm_config_prefix="$HOME/.npm-global"

# Docker optimizations for macOS
export DOCKER_BUILDKIT=1
export COMPOSE_DOCKER_CLI_BUILD=1

# Homebrew privacy
export HOMEBREW_NO_ANALYTICS=1
export HOMEBREW_NO_INSECURE_REDIRECT=1

# Google Cloud SDK auth plugin
export USE_GKE_GCLOUD_AUTH_PLUGIN=True

# Kubernetes
# k9s on macOS defaults to ~/Library/Application Support/k9s, so without this
# the `k9s` stow package at ~/.config/k9s is inert — config, skin, hotkeys and
# plugins all silently ignored, with no error. Do not remove.
export K9S_CONFIG_DIR="$HOME/.config/k9s"
# Logs and screen dumps stay out of the repo: they are state, not config, and
# ~/.config/k9s is a symlink into ~/.dotfiles.
export K9S_LOGS_DIR="$HOME/.local/state/k9s"
# Merge-friendly kubeconfig: ~/.kube/config is the homelab k3s admin
# credential (see homelab repo, `make kubeconfig`). Extra clusters can be
# appended here colon-separated rather than overwriting it.
export KUBECONFIG="$HOME/.kube/config"

# macOS fork safety (TODO: verify if still needed on current macOS)
export OBJC_DISABLE_INITIALIZE_FORK_SAFETY=YES
